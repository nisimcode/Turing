*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
.venv/
venv/
.uv/

# ---- Node / pnpm ----
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Workspace and tool caches ----
.cache/
.uv-cache/
.agents/
.claude/
.turing/

# ---- Generated model output (regenerable by re-running the scripts) ----
gate/corpus/
eval/artifacts/
.llm-cache/
gate/q26-results*.json

# ---- Browser automation / test output ----
test-results/
playwright-report/
*.webm
trace.zip

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
*.tmp
*.temp
*.log

